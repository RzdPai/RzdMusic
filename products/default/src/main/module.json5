{
  "module": {
    "name": "musichomesample",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "MusichomeAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:reason_microphone",
        "usedScene": {
          "abilities": [
            "MusichomeAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:reason_background",
        "usedScene": {
          "abilities": [
            "MusichomeAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.ACCESS_CAR_DISTRIBUTED_ENGINE"
      }
    ],
    "abilities": [
      {
        "name": "MusichomeAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:ic_music_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "minWindowHeight": 480,
        "minWindowWidth": 360,
        "orientation": "follow_desktop",
        "backgroundModes": [
          "audioPlayback"
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            // 「用派音打开 .js」= 导入音源脚本（文件管理器 / 其他应用的「打开方式」）。
            //
            // 按官方「拉起文件处理类应用」的写法：actions 声明数据处理能力、
            // uris.scheme 为 file、type 用**统一数据类型（UTD）**、linkFeature 固定 FileOpen。
            // `general.java-script` 就是 JavaScript 源文件那一类（见 @ohos.data.uniformTypeDescriptor）。
            // ⚠️ linkFeature 大小写敏感，且大小写写错就不会出现在「打开方式」里。
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "general.java-script",
                "linkFeature": "FileOpen"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "MusicCardAbility",
        "srcEntry": "./ets/musiccard/MusicCardAbility.ets",
        "type": "form",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      },
      {
        "name": "MusichomeBackupAbility",
        "srcEntry": "./ets/phonebackupextability/PhoneBackupExtAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          },
        ]
      },
      {
        "name": "LiveViewExtAbility",
        "srcEntry": "./ets/liveview/LiveViewExtAbility.ets",
        "type": "liveViewLockScreen",
        "exported": false
      }
    ]
  }
}