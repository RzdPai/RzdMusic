{
  "module": {
    "name": "musichomesample",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "MusichomeAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      // ★★ 2026-10-20：**智感握姿**（交互手/握持手）必需。
      //   `motion.on('operatingHandChanged')` 的 d.ts 明确标注
      //   `@permission ohos.permission.ACTIVITY_MOTION or ohos.permission.DETECT_GESTURE`；
      //   缺权限只抛 201 Permission denied ⇒ 表现就是「定位按钮不跟手换边」。
      //   `DETECT_GESTURE` 是 **system_grant / normal**（已查 `PermissionDefinitions.json`），
      //   声明即生效、不需要运行时弹窗；`ACTIVITY_MOTION` 是 user_grant，不要用它。
      {
        "name": "ohos.permission.DETECT_GESTURE"
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:reason_microphone",
        "usedScene": {
          "abilities": [
            "MusichomeAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:reason_background",
        "usedScene": {
          "abilities": [
            "MusichomeAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.ACCESS_CAR_DISTRIBUTED_ENGINE"
      }
    ],
    "abilities": [
      {
        "name": "MusichomeAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:ic_music_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "minWindowHeight": 480,
        "minWindowWidth": 360,
        // ★★★ 2026-10-21（甲方：「手机上现在即便关闭旋转锁定也不能横屏，你处理一下」）：
        //   原来这里是 `follow_desktop`（= 跟随桌面旋转：桌面能转才转）。
        //   手机/阔屏手机（如 PuraXMax）的桌面本身固定竖屏 ⇒ 本应用被"锁死"在竖屏，
        //   连系统旋转开关关了也转不了 —— 这正是甲方看到的现象。
        //   官方《应用配置文件 module.json5 · abilities.orientation》原文：
        //     · `auto_rotation`：随传感器旋转（不看系统开关）；
        //     · `auto_rotation_restricted`：**传感器开关打开，方向可随传感器旋转** ← 语义正是
        //       "关掉旋转锁定才能转、开着锁定就锁住"，与甲方要求一致；
        //     · `follow_desktop`：跟随桌面的旋转模式。
        //   官方《横竖屏开发指导》也写「如果应用是可旋转应用，建议配置 auto_rotation_restricted」。
        //   文档已落 `docs/official-orientation.md`。排查关键字：设置里关掉旋转锁定后转动设备。
        "orientation": "auto_rotation_restricted",
        "backgroundModes": [
          "audioPlayback"
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            // 「用派音打开 .js」= 导入音源脚本（文件管理器 / 其他应用的「打开方式」）。
            //
            // 按官方「拉起文件处理类应用」的写法：actions 声明数据处理能力、
            // uris.scheme 为 file、type 用**统一数据类型（UTD）**、linkFeature 固定 FileOpen。
            // `general.java-script` 就是 JavaScript 源文件那一类（见 @ohos.data.uniformTypeDescriptor）。
            // ⚠️ linkFeature 大小写敏感，且大小写写错就不会出现在「打开方式」里。
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "general.java-script",
                "linkFeature": "FileOpen"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "MusicCardAbility",
        "srcEntry": "./ets/musiccard/MusicCardAbility.ets",
        "type": "form",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      },
      {
        "name": "MusichomeBackupAbility",
        "srcEntry": "./ets/phonebackupextability/PhoneBackupExtAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          },
        ]
      },
      {
        "name": "LiveViewExtAbility",
        "srcEntry": "./ets/liveview/LiveViewExtAbility.ets",
        "type": "liveViewLockScreen",
        "exported": false
      }
    ]
  }
}